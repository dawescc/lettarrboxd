# Radarr
RADARR_URL=
RADARR_TOKEN=
# Quality profile name — omit to use the first profile in Radarr
QUAL_PROF_MOVIES=
# Root folder path — omit to use the first root folder in Radarr
RADARR_ROOT_FOLDER=

# Sonarr
SONARR_URL=
SONARR_TOKEN=
# Quality profile name — omit to use the first profile in Sonarr
QUAL_PROF_SERIES=
# Root folder path — omit to use the first root folder in Sonarr
SONARR_ROOT_FOLDER=

# Sources
# Comma-separated full Letterboxd URLs (watchlists, lists, actor/director pages, etc.)
# Examples:
#   https://letterboxd.com/username/watchlist/
#   https://letterboxd.com/username/list/my-list/
#   https://letterboxd.com/director/stanley-kubrick/
#   https://letterboxd.com/films/popular/
LETTERBOXD_LISTS=

# Comma-separated Serializd URLs (paste directly from the browser)
# Examples:
#   https://serializd.com/user/username/watchlist
#   https://serializd.com/user/username/lists/my-list-slug
#   https://serializd.com/list/My-List-Name-123
SERIALIZD_LISTS=

# Tag management
# Tag applied to every item added/managed by this app in Radarr and Sonarr.
# Used to identify managed items and detect orphans. Recommended.
MASTER_TAG=lettarrboxd

# When true: items with MASTER_TAG that are no longer in any list are deleted.
# When false (default): the MASTER_TAG is removed but the item stays in Radarr/Sonarr.
DELETE_ORPHANS=true

# Optional
# DEBUG | INFO | WARN | ERROR (default: WARN)
LOG_LEVEL=WARN

# Path to the SQLite cache db. Mount the parent dir as a volume in compose.
DB_PATH=/data/lettarrboxd.db

# How often to sync, in minutes (default: 60)
SYNC_INTERVAL=60

# Per-request fetch timeout, in seconds (default: 30)
FETCH_TIMEOUT=30

# Log what would happen without making any changes (default: false)
DRY_RUN=false
